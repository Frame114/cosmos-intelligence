# Local Docker Compose defaults. Replace only local nonsecret values as needed.
APP_ENV=development
APP_NAME=Cosmos Intelligence
LOG_LEVEL=INFO
PUBLIC_BASE_URL=http://localhost:8080

# Compose service network connection. Keep the password local and unique.
DATABASE_URL=postgresql+asyncpg://cosmos:cosmos_local_only@postgres:5432/cosmos
DB_POOL_SIZE=5
WORKER_POLL_INTERVAL_SECONDS=2
WORKER_LEASE_SECONDS=300
WORKER_SCHEDULES_ENABLED=false

# NASA API access. Keep private keys in ignored .env or file-backed runtime secrets.
NASA_API_KEY=DEMO_KEY
NASA_API_TIMEOUT_SECONDS=15
NASA_MAX_CONCURRENCY=4

# Optional AI provider. Generation stays disabled unless policy approval is explicit.
OPENROUTER_ENABLED=false
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
NASA_AI_POLICY_APPROVED=false
AI_MAX_OUTPUT_TOKENS=1200
AI_DAILY_TOKEN_BUDGET=20000

# Local-only development identity. Production must leave this disabled.
DEV_AUTH_ENABLED=true
OIDC_ISSUER_URL=
OIDC_AUDIENCE=
OIDC_CLIENT_ID=

# Same-origin Caddy serves the app; extra origins are only for local development.
CORS_ALLOWED_ORIGINS=
CADDY_ADDRESS=:80

# One-process limits; configure a shared limiter before scaling API replicas.
PUBLIC_RATE_LIMIT_PER_MINUTE=120
AI_RATE_LIMIT_PER_MINUTE=5
AI_RATE_LIMIT_PER_DAY=30
REPORT_RATE_LIMIT_PER_HOUR=3
