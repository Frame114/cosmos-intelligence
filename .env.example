# Application
APP_ENV=development
APP_NAME=Cosmos Intelligence
LOG_LEVEL=INFO

# NASA API
# Obtain a key from https://api.nasa.gov/
# Keep real credentials in .env; never commit them.
NASA_API_KEY=DEMO_KEY
NASA_API_TIMEOUT_SECONDS=20

# Database (configure when persistence is introduced)
DATABASE_URL=postgresql+psycopg://cosmos:change-me@localhost:5432/cosmos_intelligence

# AI provider (optional; configure only when the AI module is implemented)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=